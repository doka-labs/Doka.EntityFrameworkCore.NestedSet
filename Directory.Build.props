<Project>
  <PropertyGroup Label="Target framework and build outputs">
    <TargetFramework>net10.0</TargetFramework>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <IncludeProjectNameInArtifactsPaths>true</IncludeProjectNameInArtifactsPaths>
    <UseArtifactsIntermediateOutput>true</UseArtifactsIntermediateOutput>
  </PropertyGroup>

  <PropertyGroup Label="Default artifacts path" Condition="'$(ArtifactsPath)' == ''">
    <!-- WHY: Release formatting supplies its isolated output path through an environment property. -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Label="Compiler and analysis">
    <LangVersion>latestMajor</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Dependency restore and audit">
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- WHY: Advisories published upstream (NU1901 low, NU1902 moderate, NU1903 high, NU1904 critical) must not
         fail every build without a source change. Release-line maintenance and release-candidate consumers still
         treat them as errors before anything is published. -->
    <WarningsNotAsErrors>
      $(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904
    </WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="CI and release isolation">
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Project defaults">
    <IsPackable>false</IsPackable>
    <!-- WHY: Only publishable src projects need XML API docs; src/Directory.Build.props enables them. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
