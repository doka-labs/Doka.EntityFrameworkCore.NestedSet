<Project>
  <PropertyGroup Label="Central package management">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="Qualification transitive security floor"
                 Condition="'$(MSBuildProjectName)' != 'Doka.NestedSet'
                            and '$(MSBuildProjectName)' != 'Doka.EntityFrameworkCore.NestedSet'
                            and '$(MSBuildProjectName)' != 'Doka.EntityFrameworkCore.NestedSet.MySql'
                            and '$(MSBuildProjectName)' != 'Doka.EntityFrameworkCore.NestedSet.Postgres'
                            and '$(MSBuildProjectName)' != 'Doka.EntityFrameworkCore.NestedSet.Sqlite'
                            and '$(MSBuildProjectName)' != 'Doka.EntityFrameworkCore.NestedSet.SqlServer'">
    <!-- WHY: SQL Client still requests vulnerable PKCS 9.0.11. Pin its existing dependency without
         promoting qualification-only packages into shipping package dependency contracts. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Production">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14"/>
  </ItemGroup>

  <ItemGroup Label="Production analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0"/>
  </ItemGroup>

  <!-- Native adapters declare bounded production compatibility below; qualification uses these fixed baselines. -->
  <ItemGroup Label="Database provider baselines">
    <PackageVersion Include="Doka.EntityFrameworkCore.MySql" Version="10.6.3"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14"/>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
  </ItemGroup>

  <ItemGroup Label="Optional SafeMigrations qualification">
    <PackageVersion Include="Doka.EntityFrameworkCore.SafeMigrations.MySql" Version="10.6.1"/>
    <PackageVersion Include="Doka.EntityFrameworkCore.SafeMigrations.PostgreSql" Version="10.6.1"/>
    <PackageVersion Include="Doka.EntityFrameworkCore.SafeMigrations.SqlServer" Version="10.6.1"/>
    <PackageVersion Include="Doka.EntityFrameworkCore.SafeMigrations.Sqlite" Version="10.6.1"/>
  </ItemGroup>

  <ItemGroup Label="Test tooling">
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14"/>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2"/>
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
  </ItemGroup>

  <ItemGroup Label="SQL Server qualification security">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14"/>
  </ItemGroup>

  <ItemGroup Label="Container-backed tests and benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0"/>
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0"/>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0"/>
  </ItemGroup>

  <ItemGroup Label="Shared test specifications"
             Condition="'$(MSBuildProjectName)' == 'Doka.EntityFrameworkCore.NestedSet.Specification.Tests'">
    <!-- WHY: The shared library uses existing framework components without changing other test lockfiles. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2"/>
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2"/>
  </ItemGroup>

  <ItemGroup Label="Production EF Core compatibility"
             Condition="'$(MSBuildProjectName)' == 'Doka.EntityFrameworkCore.NestedSet'">
    <!-- WHY: The shipping contract supports EF Core 10; a new major requires explicit compatibility validation. -->
    <PackageVersion Update="Microsoft.EntityFrameworkCore" Version="[10.0.12,11.0.0)"/>
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.12,11.0.0)"/>
  </ItemGroup>

  <ItemGroup Label="Production MySql provider compatibility"
             Condition="'$(MSBuildProjectName)' == 'Doka.EntityFrameworkCore.NestedSet.MySql'">
    <!-- WHY: The typed source-binding and ordered-join APIs first qualified here belong to the Doka 10.6 line. -->
    <PackageVersion Update="Doka.EntityFrameworkCore.MySql" Version="[10.6.3,10.7.0)"/>
  </ItemGroup>

  <ItemGroup Label="Production Postgres provider compatibility"
             Condition="'$(MSBuildProjectName)' == 'Doka.EntityFrameworkCore.NestedSet.Postgres'">
    <PackageVersion Update="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[10.0.3,11.0.0)"/>
  </ItemGroup>

  <ItemGroup Label="Production Sqlite provider compatibility"
             Condition="'$(MSBuildProjectName)' == 'Doka.EntityFrameworkCore.NestedSet.Sqlite'">
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Sqlite" Version="[10.0.13,11.0.0)"/>
  </ItemGroup>

  <ItemGroup Label="Production SqlServer provider compatibility"
             Condition="'$(MSBuildProjectName)' == 'Doka.EntityFrameworkCore.NestedSet.SqlServer'">
    <PackageVersion Update="Microsoft.EntityFrameworkCore.SqlServer" Version="[10.0.13,11.0.0)"/>
    <!-- WHY: PKCS 9.0.21 fixes the reviewed advisories. Keep that security minimum independent of the
         newer qualification pin so an already patched consumer is not forced into a servicing update. -->
    <PackageVersion Update="System.Security.Cryptography.Pkcs" Version="9.0.21"/>
  </ItemGroup>
</Project>
