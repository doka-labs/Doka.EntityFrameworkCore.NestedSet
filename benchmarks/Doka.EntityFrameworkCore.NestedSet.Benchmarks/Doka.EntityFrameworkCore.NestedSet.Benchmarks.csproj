<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="../../tests/Shared/DatabaseTestTargets.cs" Link="Infrastructure/DatabaseTestTargets.cs" />
    <EmbeddedResource Include="../../docker/database-images.Dockerfile" LogicalName="NestedSet.TestImages" Visible="false" />
    <ProjectReference Include="../../src/Doka.EntityFrameworkCore.NestedSet.MySql/Doka.EntityFrameworkCore.NestedSet.MySql.csproj" />
    <ProjectReference Include="../../src/Doka.EntityFrameworkCore.NestedSet.Postgres/Doka.EntityFrameworkCore.NestedSet.Postgres.csproj" />
    <ProjectReference Include="../../src/Doka.EntityFrameworkCore.NestedSet.Sqlite/Doka.EntityFrameworkCore.NestedSet.Sqlite.csproj" />
    <ProjectReference Include="../../src/Doka.EntityFrameworkCore.NestedSet.SqlServer/Doka.EntityFrameworkCore.NestedSet.SqlServer.csproj" />
    <!-- WHY: Consumer measurements execute the actual sample builders rather than copied query implementations. -->
    <ProjectReference Include="../../samples/SignalLab/SignalLab.csproj" Aliases="global,SignalSample" />
    <ProjectReference Include="../../samples/UserGroups/UserGroups.csproj" Aliases="global,UserGroupsSample" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Doka.EntityFrameworkCore.MySql" />
    <!-- WHY: The harness directly uses connector APIs. A direct edge also carries its central version into
         BenchmarkDotNet's generated host, which does not inherit the benchmark transitive-pinning defaults. -->
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <ItemGroup Label="Shared managed-save workload models">
    <!-- WHY: Tests and benchmarks execute the same EF mapping shapes without referencing a test assembly. -->
    <Compile Include="../../tests/Doka.EntityFrameworkCore.NestedSet.Unit.Tests/Unit/ManagedSave/HierarchyChangeDetectionTests.Model.cs"
             Link="Measurements/ManagedSave/Models/HierarchyChangeDetectionTests.Model.cs" />
    <Compile Include="../../tests/Doka.EntityFrameworkCore.NestedSet.Unit.Tests/Unit/ManagedSave/HierarchyChangeDetectionTests.PlanAccess.cs"
             Link="Measurements/ManagedSave/Models/HierarchyChangeDetectionTests.PlanAccess.cs" />
    <Compile Include="../../tests/Doka.EntityFrameworkCore.NestedSet.Unit.Tests/Unit/ManagedSave/ComplexTopologyRollbackTests.Model.cs"
             Link="Measurements/ManagedSave/Models/ComplexTopologyRollbackTests.Model.cs" />
    <Compile Include="../../tests/Doka.EntityFrameworkCore.NestedSet.Unit.Tests/Unit/ManagedSave/ComplexTopologyGraphRecoveryTests.Fixture.cs"
             Link="Measurements/ManagedSave/Models/ComplexTopologyGraphRecoveryTests.Fixture.cs" />
    <Compile Include="../../tests/Doka.EntityFrameworkCore.NestedSet.Unit.Tests/Unit/ManagedSave/ManagedSharingCaptureTests.Model.cs"
             Link="Measurements/ManagedSave/Models/ManagedSharingCaptureTests.Model.cs" />
    <Compile Include="../../tests/Doka.EntityFrameworkCore.NestedSet.Unit.Tests/Unit/ManagedSave/UnchangedForeignKeyRollbackTests.Model.cs"
             Link="Measurements/ManagedSave/Models/UnchangedForeignKeyRollbackTests.Model.cs" />
  </ItemGroup>
  <ItemGroup Label="IDE file nesting">
    <Compile Update="Infrastructure/BenchmarkEnvironment.*.cs">
      <DependentUpon>BenchmarkEnvironment.cs</DependentUpon>
    </Compile>
    <Compile Update="Infrastructure/BenchmarkProvenance.*.cs">
      <DependentUpon>BenchmarkProvenance.cs</DependentUpon>
    </Compile>
    <Compile Update="Queries/Consumers/Chains/UserGroupChainReference.*.cs">
      <DependentUpon>UserGroupChainReference.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
