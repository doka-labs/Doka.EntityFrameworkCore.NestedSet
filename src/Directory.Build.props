<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <PropertyGroup Label="Package metadata and release baseline">
    <!-- WHY: Local builds use the reviewed stable version; qualified candidates must retain this exact identity. -->
    <VersionPrefix>10.1.0</VersionPrefix>
    <Authors>Dominic Kalkbrenner</Authors>
    <Company>Doka Labs</Company>
    <Copyright>Copyright (c) 2026 Dominic Kalkbrenner</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <RepositoryUrl>https://github.com/doka-labs/Doka.EntityFrameworkCore.NestedSet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <DeterministicTimestamp>946684800</DeterministicTimestamp>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Published package API baselines"
                 Condition="'$(MSBuildProjectName)' == 'Doka.NestedSet'
                            or '$(MSBuildProjectName)' == 'Doka.EntityFrameworkCore.NestedSet'">
    <!-- WHY: Only these package IDs have a published predecessor. New adapters cannot restore a
         nonexistent baseline; the approved registration removal has a narrowly scoped suppression. -->
    <PackageValidationBaselineVersion>10.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Label="Package dependency locks">
    <!-- WHY: Only shipping packages commit dependency locks; test, sample, and tooling graphs are restored independently. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(RuntimeIdentifier)' == ''">true</RestoreLockedMode>
    <!-- WHY: Qualified candidates use owned lock copies so restore cannot rewrite the reviewed source locks. -->
    <NuGetLockFilePath Condition="'$(NestedSetReleaseLockRoot)' != ''">$(NestedSetReleaseLockRoot)/$(MSBuildProjectName)/packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"/>
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/"/>
    <!-- WHY: The common EF package shares the central usage guide; other packages provide their own README. -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/"
          Condition="!Exists('$(MSBuildProjectDirectory)/README.md')"/>
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/"
          Condition="Exists('$(MSBuildProjectDirectory)/README.md')"/>
  </ItemGroup>
</Project>
