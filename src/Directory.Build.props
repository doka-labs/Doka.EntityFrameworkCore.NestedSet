<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Package metadata and release baseline">
    <!-- WHY: Local builds use the reviewed stable version; qualified candidates must retain this exact identity. -->
    <VersionPrefix>10.3.0</VersionPrefix>
    <Authors>Dominic Kalkbrenner</Authors>
    <Company>Doka Labs</Company>
    <Copyright>Copyright (c) 2026 Dominic Kalkbrenner</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <RepositoryUrl>https://github.com/doka-labs/Doka.EntityFrameworkCore.NestedSet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <DeterministicTimestamp>946684800</DeterministicTimestamp>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Published package API baselines"
                 Condition="'$(MSBuildProjectName)' == 'Doka.NestedSet'
                            or '$(MSBuildProjectName)' == 'Doka.EntityFrameworkCore.NestedSet'">
    <!-- WHY: Preserve the original 10.0.0 baseline for these two package IDs and its narrowly approved
         registration-removal suppression. Adapters introduced in 10.1.0 are outside that original baseline. -->
    <PackageValidationBaselineVersion>10.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Label="Production analyzers and IDE annotations">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <!-- WHY: IDE annotations describe the actual public/reflection contract without becoming package dependencies.
         JETBRAINS_ANNOTATIONS stays undefined, so conditional attributes are omitted from emitted assemblies. -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Label="Package documentation">
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
    <!-- WHY: The common EF package shares the central usage guide; other packages provide their own README. -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/"
          Condition="!Exists('$(MSBuildProjectDirectory)/README.md')" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/"
          Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
  </ItemGroup>
</Project>
