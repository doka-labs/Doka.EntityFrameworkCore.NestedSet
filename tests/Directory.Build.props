<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- WHY: xUnit v3 runs tests in executable projects while the VSTest adapter preserves Rider discovery. -->
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WHY: Independent collections own their databases, while shared fixtures explicitly use one collection.
         Keep xUnit's CPU-based default instead of imposing a repository-wide concurrency limit. -->
    <Content Include="$(MSBuildThisFileDirectory)Shared/xunit.runner.json"
             Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
