<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WHY: Shared contracts are inherited by executable provider suites; this library has no test runner. -->
    <IsTestProject>false</IsTestProject>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WHY: Provider fixtures own their image data directly so qualification does not depend on optional tools. -->
    <Compile Include="../Shared/DatabaseTestTargets.cs" Link="Infrastructure/DatabaseTestTargets.cs"/>
    <Compile Include="../Shared/SqlServerTestPlatform.cs" Link="Infrastructure/SqlServerTestPlatform.cs"/>
    <EmbeddedResource Include="../../docker/database-images.Dockerfile" LogicalName="NestedSet.TestImages" Visible="false"/>
  </ItemGroup>

