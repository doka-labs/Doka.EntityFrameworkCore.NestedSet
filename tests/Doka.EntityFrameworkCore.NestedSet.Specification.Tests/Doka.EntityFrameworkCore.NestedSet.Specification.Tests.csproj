    <ProjectReference Include="../../src/Doka.EntityFrameworkCore.NestedSet.SqlServer/Doka.EntityFrameworkCore.NestedSet.SqlServer.csproj"/>
    <!-- WHY: Provider tests invoke the actual sample query builders rather than maintaining test-only copies. -->
    <ProjectReference Include="../../samples/SignalLab/SignalLab.csproj"/>
    <ProjectReference Include="../../samples/UserGroups/UserGroups.csproj"/>
    <!-- WHY: These existing xUnit components support a library without the executable runner targets. -->
    <PackageReference Include="xunit.v3.extensibility.core"/>
    <PackageReference Include="xunit.v3.assert"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive; compile"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"/>
    <PackageReference Include="Doka.EntityFrameworkCore.MySql"/>
